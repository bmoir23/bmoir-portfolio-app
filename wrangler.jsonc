{
	"compatibility_date": "2026-04-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"name": "bmoirdevportfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Non-sensitive runtime vars. These are safe to commit (the Sanity project ID
	// and dataset are not secrets — they're visible in every client-side request
	// to the Sanity CDN). Keeping them here means they survive redeploys, unlike
	// plaintext vars added only via the Cloudflare dashboard, which get
	// overwritten by whatever `wrangler.jsonc` defines on the next deploy.
	// Secrets (NEON_DATABASE_URL, TURNSTILE_SECRET_KEY, POSTHOG_API_KEY, etc.)
	// must stay out of this file — set those via the dashboard's "Secrets" tab
	// or `wrangler secret put <NAME>`, never as plaintext vars here.
	"vars": {
		"SANITY_PROJECT_ID": "cv6an3n5",
		"SANITY_DATASET": "portoflio-dev-blog",
		"SANITY_API_VERSION": "2024-10-01",
		"POSTHOG_HOST": "https://us.i.posthog.com"
	},
	"ai": {
		  "binding": "AI"
		},
	"analytics_engine_datasets": [
    { "binding": "ANALYTICS_ENGINE", "dataset": "dev_portfolio" }
  ],
	"observability": {
	  "enabled": false,
	  "head_sampling_rate": 1,
	  "logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"persist": true,
		"invocation_logs": true
	  },
	  "traces": {
		"enabled": true,
		"persist": true,
		"head_sampling_rate": 1
	  }
	}
}