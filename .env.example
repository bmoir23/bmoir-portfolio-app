# ─── Sanity CMS ──────────────────────────────────────────────────────────────
# Studio: sanity/ (sanity.config.ts → project cv6an3n5)
# Schemas + seed data: sanity/schemas/ and sanity/seed/
# Copy this file to `.dev.vars` (for local astro dev / wrangler) and add the
# same keys as secrets in your Cloudflare project for production.
SANITY_PROJECT_ID=cv6an3n5
SANITY_DATASET=portoflio-dev-blog
SANITY_API_VERSION=2024-10-01
# Optional — only required if your dataset is private.
SANITY_API_TOKEN=

# ─── Contact form ────────────────────────────────────────────────────────────
# The /api/contact endpoint stores submissions in Neon and/or forwards them to
# an n8n webhook. Configure at least one of the following.
#
# Neon Postgres connection string (https://console.neon.tech → your project →
# Connection Details → "Pooled connection"). See CONTACT.md for the table schema.
NEON_DATABASE_URL=
# Alias also accepted by the endpoint:
# DATABASE_URL=

# n8n webhook that receives the submission (then syncs to Notion + routes email).
N8N_CONTACT_WEBHOOK_URL=

# ─── Cloudflare Turnstile (contact form spam protection) ─────────────────────
# Create a widget at https://dash.cloudflare.com → Turnstile. The site key is
# public and embedded in the client bundle; the secret key stays server-side.
# Until you set these, the widget is hidden and server verification is skipped.
#
# Test keys (always pass) — handy for local dev:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── PostHog Analytics ───────────────────────────────────────────────────────
# Your PostHog project API key (public key). Find it at app.posthog.com → Project Settings.
# Server-side (posthog-node in API routes / SSR pages):
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Client-side (PUBLIC_ prefix embeds the value into the browser bundle at build time).
# Point this at the site's own first-party reverse proxy (src/pages/ingest/[...path].ts)
# so tracker blockers can't drop browser events by blocking the posthog.com host.
# Use your deployed origin + /ingest (e.g. https://portfolio.brianmoir.dev/ingest);
# the relative "/ingest" default also works on localhost and preview deploys.
PUBLIC_POSTHOG_API_KEY=
PUBLIC_POSTHOG_HOST=https://portfolio.brianmoir.dev/ingest
